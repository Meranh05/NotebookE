<mxfile host="app.diagrams.net" modified="2026-09-17T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="video-pipeline" name="Hình 3.14 - Video">
    <mxGraphModel dx="3000" dy="1700" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1700" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="QUY TRÌNH TẠO VIDEO TỪ NỘI DUNG NGHIÊN CỨU" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="20" width="1700" height="50" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;Khởi tạo tác vụ nền&lt;/b&gt;&lt;br&gt;Frontend gửi yêu cầu → FastAPI tạo công việc → Worker tiếp nhận và xử lý" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=#ffffff;strokeColor=#555;fontSize=17;" vertex="1" parent="1"><mxGeometry x="720" y="115" width="1560" height="95" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Chọn nội dung&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chọn sổ tay, nguồn hoặc chủ đề&lt;br&gt;&lt;i&gt;Người dùng · Frontend&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="310" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Tạo kịch bản&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sinh mạch kể và storyboard&lt;br&gt;&lt;i&gt;Worker · Language Model&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="810" y="310" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Chia thành các cảnh&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lời dẫn · bố cục · visual prompt&lt;br&gt;&lt;i&gt;Worker · Storyboard planner&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1520" y="310" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Tạo hình ảnh&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sinh hoặc dựng hình cho từng cảnh&lt;br&gt;&lt;i&gt;Image Model · Visual fallback&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="2230" y="310" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Tạo âm thanh&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tổng hợp giọng đọc cho từng cảnh&lt;br&gt;&lt;i&gt;TTS · Worker&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="2230" y="910" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Tạo phụ đề&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chia câu và tính thời lượng hiển thị&lt;br&gt;&lt;i&gt;Caption processor&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1520" y="910" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Đồng bộ và ghép cảnh&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hình ảnh · giọng đọc · phụ đề&lt;br&gt;&lt;i&gt;Frame composer · FFmpeg&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="810" y="910" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. Kết xuất và lưu video&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ghép phân đoạn, tạo MP4 và metadata&lt;br&gt;&lt;i&gt;FFmpeg · File storage · SurrealDB&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="910" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="e12" value="Nội dung" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="Kịch bản" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="Cảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" value="Xử lý từng cảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" value="Âm thanh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" value="Phụ đề" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e78" value="Phân cảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;fontSize=15;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="result" value="&lt;b&gt;Video hoàn chỉnh (.mp4) được hiển thị trên Frontend&lt;/b&gt;&lt;br&gt;Cập nhật trạng thái hoàn thành và đường dẫn tệp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111;fontSize=18;" vertex="1" parent="1"><mxGeometry x="900" y="1400" width="1200" height="110" as="geometry"/></mxCell>
