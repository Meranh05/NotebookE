
UPDATE transformation SET title = "Phân tích tài liệu", description = "Phân tích một bài báo khoa học/kỹ thuật", prompt = prompt + "\n- VUI LÒNG TRẢ LỜI HOÀN TOÀN BẰNG TIẾNG VIỆT." WHERE name = "Analyze Paper";
